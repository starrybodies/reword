# Python and local editor state
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
.venv/
venv/
.DS_Store
.idea/
.vscode/

# Credentials and environment configuration
.env
.env.*
*.pem
*.key
*.p12
*.pfx
credentials*.json
secret*.json

# Keep real writing and voice collections outside this checkout.
# These names catch common accidental local files; arbitrary names are not safe.
private/
local/
voice-stores/
voices/
collections/
samples/
drafts/
feedback/
*voice*.json
*profile*.json
!assets/voice.example.json
/draft.*
/original.*
/candidate.*
/user-revision.*
/sample.*
/inspiration.*

# Runtime exports and traces are private unless deliberately synthesized.
*.jsonl
*.trace.json
*.store.json
